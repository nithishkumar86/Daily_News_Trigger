# Supabase — Public keys (safe to expose in client code)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase — Server only (service role — never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq (LinkedIn post generation, model openai/gpt-oss-120b)
GROQ_API_KEY=gsk_...

# Content pipeline MCP key (Claude routine + Codex)
CONTENT_MCP_KEY=a-long-random-string

# Site
NEXT_PUBLIC_SITE_NAME=AI Digital Tamizah
